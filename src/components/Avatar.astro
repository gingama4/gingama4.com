---
import { Image } from "astro:assets";
import myAvatar from "@/assets/avatar.jpeg";
---

<span class="avatar">
  <Image
    src={myAvatar}
    alt="アバター画像"
    layout="constrained"
    width={512}
    height={512}
    class="avatar-image"
  />
</span>
<style>
.avatar {
  display: block;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  border: 1px solid var(--color-border);
  border-radius: 50%;

  .avatar-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
}
</style>
