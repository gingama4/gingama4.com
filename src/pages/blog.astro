---
import AsideLayout from "@layouts/AsideLayout.astro";
import ContentHeader from "@components/ContentHeader.astro";
import BlogPost from "@components/BlogPost.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
---

<AsideLayout pageTitle="Blog">
  <ContentHeader>
    <h1>Blog</h1>
    <p>学んだことや開発ログ</p>
  </ContentHeader>
  <ul>
    {allPosts.map((post) => <BlogPost url={`/posts/${post.id}`} title={post.data.title} />)}
  </ul>
</AsideLayout>
