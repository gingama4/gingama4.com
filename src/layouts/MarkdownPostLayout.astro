---
import AsideLayout from "@layouts/AsideLayout.astro";
import ContentHeader from "@components/ContentHeader.astro";
import Tag from "@components/Tag.astro";
import type { PostFrontmatter } from "@/types/content";

interface Props {
  frontmatter: PostFrontmatter;
}

const { frontmatter } = Astro.props;
---

<AsideLayout pageTitle={frontmatter.title}>
  <article class="post">
    <ContentHeader>
      <h1>{frontmatter.title}</h1>
      <p>Publish: {frontmatter.pubDate.toLocaleDateString()}</p>
    </ContentHeader>

    <div class="post-content">
      <slot />
    </div>

    <div class="tags">
      {frontmatter.tags.map((tag: string) => (
      <Tag tag={tag} />
    ))}
    </div>
  </article>
</AsideLayout>
<style>
.post-content :global(h2) {
  margin-block: 2.5rem 1rem;
  line-height: 1.3;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}
</style>
